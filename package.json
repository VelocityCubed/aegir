{
  "name": "wavelab-tl-studio",
  "productName": "AEONFORGE Aegir",
  "version": "0.9.5",
  "description": "Aeonforge Aegir \u2014 personal-use acoustic engineering, transmission-line design and MCP automation",
  "author": "Aeonforge",
  "type": "module",
  "main": "electron/main.cjs",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "node scripts/dev.mjs",
    "start": "electron .",
    "build": "tsc -b && npm run build:engine && vite build",
    "test": "vitest run",
    "test:e2e": "node scripts/studio-e2e.mjs",
    "package": "npm run build && electron-builder --win portable",
    "package:dir": "npm run build && electron-builder --dir",
    "setup:cad": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-cad.ps1",
    "build:engine": "node scripts/build-engine.mjs",
    "mcp": "node mcp/server.mjs",
    "test:mcp": "node scripts/mcp-e2e.mjs",
    "test:cad": "node scripts/verify-cad.mjs",
    "licenses": "node scripts/collect-licenses.mjs",
    "test:lifecycle": "node scripts/mcp-autolaunch.mjs",
    "test:field": "node scripts/field-e2e.mjs",
    "test:guided": "node scripts/studio-e2e.mjs",
    "test:editor": "node scripts/editor-e2e.mjs",
    "benchmark:satori": "node scripts/satori-benchmark.mjs",
    "verify:satori": "node scripts/satori-benchmark.mjs --check",
    "test:system": "node scripts/system-e2e.mjs",
    "test:physics": "node scripts/physics-e2e.mjs",
    "benchmark:upgrades": "node scripts/satori-upgrade-benchmark.mjs",
    "benchmark:modal": "node scripts/modal-benchmark.mjs",
    "test:studio": "node scripts/studio-e2e.mjs",
    "test:crossover": "node scripts/crossover-e2e.mjs",
    "test:circuit-field": "node scripts/circuit-field-e2e.mjs",
    "benchmark:worksheet": "node scripts/worksheet-benchmark.mjs",
    "verify:worksheet": "node scripts/worksheet-benchmark.mjs --check",
    "benchmark:geometry": "node scripts/geometry-convergence.mjs",
    "verify:accuracy": "node scripts/accuracy-gate.mjs",
    "test:worksheet": "node scripts/worksheet-e2e.mjs",
    "test:pressure-ui": "node scripts/pressure-ui-e2e.mjs",
    "benchmark:stuffing": "node scripts/stuffing-benchmark.mjs",
    "test:stuffing": "node scripts/stuffing-e2e.mjs",
    "test:convergence": "node scripts/convergence-e2e.mjs",
    "benchmark:king": ".venv/Scripts/python.exe scripts/king-reference.py && node scripts/anatomy-benchmark.mjs"
  },
  "build": {
    "appId": "org.wavelab.tlstudio",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "docs/**/*",
      "!docs/speaker-design/**/*",
      "engine/**/*",
      "README.md",
      "CONTRIBUTING.md"
    ],
    "extraResources": [
      {
        "from": "cad",
        "to": "cad"
      },
      {
        "from": "mcp",
        "to": "mcp"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "signExecutable": false,
      "icon": "electron/icon.ico"
    },
    "artifactName": "AEONFORGE-Aegir-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelocityCubed/aegir.git"
  },
  "homepage": "https://github.com/VelocityCubed/aegir#readme",
  "bugs": {
    "url": "https://github.com/VelocityCubed/aegir/issues"
  }
}
